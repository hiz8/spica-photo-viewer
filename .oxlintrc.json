{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // oxlint の既定プラグインは typescript / unicorn / oxc のみ。react・jsx-a11y・
  // import・promise を足さないと、Biome の recommended が見ていた React フック
  // 依存配列とアクセシビリティの領域が丸ごと無検査になる。
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react",
    "jsx-a11y",
    "import",
    "promise"
  ],
  // 既定は correctness のみ。Biome recommended 相当の網羅には suspicious まで
  // 必要（exhaustive-effect-dependencies などがこちらに属する）。pedantic /
  // style は no-magic-numbers・sort-keys の類で性格が違うため入れない。
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "env": {
    "builtin": true,
    "browser": true
  },
  // 型認識ルールを動かすには tsgolint（oxlint-tsgolint）が要る。まずは
  // prefer-optional-chain のために入れた（Biome recommended の useOptionalChain
  // 相当で、型情報が無いと 1 件も検出できない）。同時に起動する他のルールは
  // 下で 1 つずつ採否を決めてある。
  "options": {
    "typeAware": true
  },
  "rules": {
    "typescript/prefer-optional-chain": "error",
    // 本体コードでの指摘が 0 件だった 3 つ。テストでは `as` とメソッド参照が
    // 通常の書き方なので overrides で外す。
    "typescript/unbound-method": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-type-arguments": "error",
    // 残る 4 つ。no-floating-promises（本体 15 件）はフックとイベントハンドラ
    // 全体に散っていて、void を付けるだけの箇所と本当に catch すべき箇所が
    // 混ざるため単独で扱う。他の 3 つも本体に指摘が残っているので同様。
    "typescript/no-floating-promises": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/restrict-template-expressions": "off",
    // tsconfig.json の jsx は react-jsx（自動 JSX ランタイム）。React を
    // スコープに入れる必要はない。
    "react/react-in-jsx-scope": "off",
    // 先頭アンダースコアは「本番コードから呼ぶな」を示す本プロジェクトの印。
    // 既存の 4 つだけを許可し、無制限のアンダースコア命名は引き続き弾く。
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": [
          "__PERF__",
          "__SPICA_TEST__",
          "__RESIZES__",
          "__FRAMES__",
          "_setPerfEnabledForTests",
          "_resetPreviewBoxForTests"
        ]
      }
    ],
    // CSS の副作用 import と jest-dom のマッチャ登録は、値を持たないのが正しい形。
    "import/no-unassigned-import": [
      "error",
      { "allow": ["**/*.css", "@testing-library/jest-dom"] }
    ],
    // チェーン末尾の then() は副作用専用で、戻り値を受け取る呼び出し側がいない。
    "promise/always-return": ["error", { "ignoreLastCallback": true }]
  },
  "overrides": [
    {
      // e2e の spec も同じテストコード。__tests__ 配下ではないので明示する。
      "files": ["**/__tests__/**", "e2e/specs/**"],
      "rules": {
        // テストのヘルパーは、対応する describe の中に置いて初めて何のための
        // スタブか読める。モジュール先頭への巻き上げは可読性を下げる。
        "unicorn/consistent-function-scoping": "off",
        // モックを `vi.fn()` のまま渡す・`as` で型を詰めるのはテストの定型で、
        // 本番コードと同じ厳しさを当てると書き方そのものを歪める。
        "typescript/unbound-method": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unnecessary-type-arguments": "off"
      }
    },
    {
      "files": ["e2e/specs/**"],
      "rules": {
        // `browser.executeAsync` の契約そのもの。ページ側で走るスクリプトは
        // 結果を返す手段が done コールバックしかなく、fetch の then から呼ぶ
        // 以外の書き方が存在しない。
        "promise/no-callback-in-promise": "off"
      }
    }
  ]
}
