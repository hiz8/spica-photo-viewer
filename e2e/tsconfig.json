{
  "compilerOptions": {
    // Match the app's tsconfig: the specs run on Node 22 and in WebView2,
    // both of which have the ES2023 array methods (toSorted/toReversed).
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Specs import helpers with an explicit .ts extension so wdio's ESM TS
    // loader resolves them without an extension-guessing step.
    "allowImportingTsExtensions": true,
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/mocha-framework",
      "@wdio/tauri-service"
    ],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["./**/*.ts"]
}
