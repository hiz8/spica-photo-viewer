{
  "name": "spica-photo-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0 <21 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-version.cjs && tsc --project tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "sync-version": "node scripts/sync-version.cjs",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "bench:build": "node e2e/scripts/build-bench.mjs",
    "bench:corpus": "node e2e/scripts/generate-corpus.mjs",
    "profile:rust": "node e2e/scripts/profile-rust.mjs",
    "profile:nav-rapid": "node e2e/scripts/profile-nav-rapid.mjs",
    "profile:nav-rapid:analyze": "node e2e/scripts/analyze-nav-rapid.mjs",
    "test:e2e": "wdio run e2e/wdio.conf.ts --spec e2e/specs/smoke.e2e.ts --spec e2e/specs/centering.e2e.ts --spec e2e/specs/preview.e2e.ts --spec e2e/specs/preview-display.e2e.ts --spec e2e/specs/visual.e2e.ts",
    "bench": "node e2e/scripts/run-bench.mjs",
    "bench:baseline": "node e2e/scripts/save-baseline.mjs",
    "type-check": "tsc --noEmit",
    "type-check:test": "tsc --project tsconfig.test.json --noEmit && tsc --project e2e/tsconfig.json --noEmit",
    "lint": "biome lint src/",
    "lint:fix": "biome lint src/ --write",
    "format": "biome format src/",
    "format:fix": "biome format src/ --write"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@wdio/cli": "^9.31.3",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-service": "^1.3.0",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
